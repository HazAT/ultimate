{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc-web",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite-plus/client"],
    "jsx": "react-jsx",
    "strict": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@/sdk": ["./web/src/compat/sdk.ts"],
      "@/components/ui/button": ["./web/src/compat/ui/button.tsx"],
      "@/components/ui/checkbox": ["./web/src/compat/ui/checkbox.tsx"],
      "@/components/ui/collapsible": ["./web/src/compat/ui/collapsible.tsx"],
      "@/components/ui/command": ["./web/src/compat/ui/command.tsx"],
      "@/components/ui/dialog": ["./web/src/compat/ui/dialog.tsx"],
      "@/components/ui/dropdown-menu": ["./web/src/compat/ui/dropdown-menu.tsx"],
      "@/components/ui/kbd": ["./web/src/compat/ui/kbd.tsx"],
      "@/components/ui/popover": ["./web/src/compat/ui/popover.tsx"],
      "@/components/ui/skeleton": ["./web/src/compat/ui/skeleton.tsx"],
      "@/components/ui/switch": ["./web/src/compat/ui/switch.tsx"],
      "@/components/ui/tooltip": ["./web/src/compat/ui/tooltip.tsx"],
      "@/components/ai/tool": ["./web/src/compat/ai/tool.tsx"],
      "@/components/ai/message": ["./web/src/compat/ai/message.tsx"],
      "@/*": ["./web/src/*"]
    }
  },
  "include": [
    "web/src",
    "extensions/**/*.tsx",
    ".ultimate/extensions/**/*.tsx",
    "shared/protocol.ts",
    "shared/events.ts",
    "shared/extension-api.ts",
    "extensions/*/refs.ts",
    ".ultimate/extensions/*/refs.ts",
    "extensions/*/entries.ts",
    "extensions/activity/events.ts",
    "extensions/coding-tools/bash-command.ts",
    "extensions/coding-tools/diff.ts",
    "extensions/automations/form-draft.ts",
    "extensions/automations/looks.ts",
    "extensions/automations/navigation.ts",
    "extensions/automations/poll.ts",
    "extensions/automations/waits.ts",
    "extensions/automations/words.ts",
    "extensions/messages/accent.ts",
    "extensions/messages/caller.ts",
    "extensions/messages/data.ts",
    "extensions/messages/points.ts",
    "extensions/messages/waiting.ts",
    "extensions/messages/working.ts",
    "extensions/projects/links.ts",
    "extensions/sidebar/colour.ts",
    "extensions/sidebar/points.ts",
    "extensions/cloud/types.ts",
    "extensions/conversations/mark-style.ts",
    "extensions/conversations/points.ts",
    "extensions/conversations/types.ts",
    "extensions/conversations/visible.ts",
    "extensions/conversations/points.ts",
    "extensions/dream/stage.ts",
    "extensions/dream/types.ts",
    "extensions/lineage/types.ts",
    "extensions/lineage/points.ts",
    "extensions/lineage/memory-chip.ts",
    "extensions/system/tab.ts",
    "extensions/phase/types.ts",
    "extensions/phase/subtree.ts",
    "extensions/plan/body.ts",
    "extensions/plan/progress.ts",
    "extensions/plan/status.ts",
    "extensions/recall/types.ts",
    "extensions/conversations/summary-model-ref.ts",
    "extensions/models/state.ts",
    "extensions/models/family-state.ts",
    "extensions/models/switches.ts",
    "extensions/context/breakdown.ts",
    "extensions/status-line/context.ts",
    "extensions/status-line/turns.ts",
    "extensions/sounds/cues.ts",
    "extensions/keep-warm/due.ts",
    "extensions/inbox/items.ts",
    "extensions/questions/open.ts",
    "extensions/questions/state.ts",
    "extensions/sounds/tones.ts",
    "extensions/sounds/agents.ts",
    "extensions/sounds/conductor.ts",
    "extensions/sounds/engine.ts",
    "extensions/sounds/narration.ts",
    "extensions/sounds/speaker.ts",
    "extensions/sounds/voiced.ts",
    "extensions/instance/links.ts",
    "extensions/instance/previews.ts",
    "extensions/update/item.ts",
    "extensions/attachments/limits.ts",
    "extensions/pause/lasted.ts",
    "extensions/pause/parked.ts",
    "extensions/sidebar/work.ts",
    "extensions/sidebar/landings.ts",
    "extensions/subagents/landing.ts",
    "extensions/subagents/source.ts",
    "extensions/onboarding/choices.ts",
    "extensions/onboarding/onboarded.ts",
    "extensions/onboarding/dialogs.ts",
    "extensions/side-chat/front.ts",
    "extensions/side-chat/logic.ts",
    "extensions/tasks/kinds.ts",
    "extensions/tasks/tree.ts",
